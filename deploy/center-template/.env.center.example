CENTER_SLUG=center_a
CENTER_NAME=Center A
CENTER_DOMAIN=center-a.example.com
COMPOSE_PROJECT_NAME=globalcanvas_center_a

# App
NODE_ENV=production
PORT=3000
APP_PORT=3000
NEXT_PUBLIC_APP_URL=https://center-a.example.com

# Database (isolated per center)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=globalcanvas_center_a
POSTGRES_USER=gc_center_a
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql://gc_center_a:change_me_strong_password@postgres:5432/globalcanvas_center_a

# Auth (isolated per center)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_center_a
CLERK_SECRET_KEY=sk_live_center_a
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/

# Media (isolated per center)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=center_a_cloud
NEXT_PUBLIC_CLOUDINARY_API_KEY=center_a_cloudinary_key

# Monitoring (isolated per center)
NEXT_PUBLIC_SENTRY_DSN=https://public_key@o0.ingest.sentry.io/0
SENTRY_DSN=https://public_key@o0.ingest.sentry.io/0

# Optional metadata used by operations/runbooks
BACKUP_TARGET=s3://globalcanvas-center-a-backups
BACKUP_SCHEDULE=0 2 * * *
